{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "vynbynave.vercel.app" }],
      "destination": "https://nxstops.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "nxstops-new.vercel.app" }],
      "destination": "https://nxstops.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/events", "destination": "/api/events" },
    { "source": "/api/places", "destination": "/api/places" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
