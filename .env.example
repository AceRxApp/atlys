# Server-side API keys (used by Vercel API routes — never exposed to browser)
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# Client-side keys (prefixed with VITE_ — bundled into the frontend)
VITE_GOOGLE_MAPS_API_KEY=

# Supabase (server-side — used by API routes)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Admin (server-side only — never exposed to browser)
ADMIN_EMAIL=

# OpenAI (server-side — used by /api/chat)
OPENAI_API_KEY=
