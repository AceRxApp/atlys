# Server-side API keys (used by Vercel API routes — never exposed to browser)
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# Client-side keys (prefixed with VITE_ — bundled into the frontend)
VITE_GOOGLE_MAPS_API_KEY=

# Supabase (server-side — used by API routes)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase Service Role (server-side only — used by /api/account-delete for user deletion)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (client-side — bundled into frontend, safe to expose anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin (server-side only — never exposed to browser)
ADMIN_EMAIL=

# Groq (server-side — used by /api/chat and /api/plan-day)
GROQ_API_KEY=

# Events (server-side — used by /api/events)
# At least one is needed for events to load
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=
PREDICTHQ_TOKEN=

# Upstash Redis (server-side — persistent rate limiting)
# If not set, falls back to in-memory rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
